@model vroom.Models.ApplicationUser

@{
    ViewData["Title"] = $"მომხმარებელი - {Model.FullName}";
    var userOrders = ViewBag.UserOrders as List<vroom.Models.Order> ?? new List<vroom.Models.Order>();
}

<div class="container-fluid mt-4">
    <a href="@Url.Action("Users", "Admin")" class="btn btn-outline-secondary mb-3">← მომხმარებლები</a>

    <div class="row">
        <div class="col-lg-4">
            <div class="card mb-4">
                <div class="card-header bg-dark text-white">
                    <h5 class="mb-0">👤 მომხმარებლის ინფო</h5>
                </div>
                <div class="card-body">
                    <dl class="row mb-0">
                        <dt class="col-sm-4">სახელი</dt>
                        <dd class="col-sm-8">@Model.FullName</dd>

                        <dt class="col-sm-4">ელფოსტა</dt>
                        <dd class="col-sm-8">@Model.Email</dd>

                        <dt class="col-sm-4">ტელ.</dt>
                        <dd class="col-sm-8">@(Model.PhoneNumber ?? "—")</dd>

                        <dt class="col-sm-4">მისამართი</dt>
                        <dd class="col-sm-8">@(Model.Address ?? "—")</dd>

                        <dt class="col-sm-4">ქალაქი</dt>
                        <dd class="col-sm-8">@(Model.City ?? "—")</dd>

                        <dt class="col-sm-4">საფოსტო</dt>
                        <dd class="col-sm-8">@(Model.PostalCode ?? "—")</dd>

                        <dt class="col-sm-4">რეგისტრაცია</dt>
                        <dd class="col-sm-8">@Model.CreatedAt.ToString("dd.MM.yyyy")</dd>

                        <dt class="col-sm-4">როლი</dt>
                        <dd class="col-sm-8">
                            @if (Model.IsAdmin)
                            {
                                <span class="badge bg-danger">Admin</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">User</span>
                            }
                        </dd>
                    </dl>
                </div>
            </div>

            <div class="card mb-4">
                <div class="card-header bg-warning text-dark">
                    <h5 class="mb-0">⚙️ ადმინ მოქმედებები</h5>
                </div>
                <div class="card-body d-grid gap-2">
                    @if (TempData["SuccessMessage"] != null)
                    {
                        <div class="alert alert-success">@TempData["SuccessMessage"]</div>
                    }
                    @if (Model.IsAdmin)
                    {
                        <form method="post" asp-action="RemoveAdmin" asp-route-id="@Model.Id">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-warning w-100"
                                onclick="return confirm('ადმინის უფლება ჩამოართვათ?')">ადმინის უფლების წაშლა</button>
                        </form>
                    }
                    else
                    {
                        <form method="post" asp-action="MakeAdmin" asp-route-id="@Model.Id">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-success w-100">ადმინად დანიშვნა</button>
                        </form>
                    }
                </div>
            </div>
        </div>

        <div class="col-lg-8">
            <div class="card">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">📦 შეკვეთები (@userOrders.Count)</h5>
                </div>
                @if (!userOrders.Any())
                {
                    <div class="card-body text-muted">ამ მომხმარებელს შეკვეთები არ აქვს.</div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover mb-0">
                            <thead class="table-dark">
                                <tr>
                                    <th>ID</th>
                                    <th>თარიღი</th>
                                    <th>ფასი</th>
                                    <th>სტატუსი</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var order in userOrders.OrderByDescending(o => o.OrderDate))
                                {
                                    <tr>
                                        <td><strong>#@order.Id</strong></td>
                                        <td>@order.OrderDate.ToString("dd.MM.yyyy HH:mm")</td>
                                        <td>₾@order.TotalPrice.ToString("F2")</td>
                                        <td>
                                            @{
                                                var badge = order.Status switch
                                                {
                                                    vroom.Models.OrderStatus.Pending    => "bg-warning text-dark",
                                                    vroom.Models.OrderStatus.Processing => "bg-info",
                                                    vroom.Models.OrderStatus.Shipped    => "bg-primary",
                                                    vroom.Models.OrderStatus.Delivered  => "bg-success",
                                                    vroom.Models.OrderStatus.Cancelled  => "bg-danger",
                                                    _                                   => "bg-secondary"
                                                };
                                            }
                                            <span class="badge @badge">@order.Status</span>
                                        </td>
                                        <td>
                                            <a href="@Url.Action("OrderDetails", "Admin", new { id = order.Id })" class="btn btn-sm btn-outline-primary">დეტალები</a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
